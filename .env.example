DATABASE_URL=postgresql://zarsignal:local_dev_password@localhost:5432/zarsignal?schema=public
MARKET_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Approve Faraz and/or the previous HTML source in Admin > Data. Secrets are never required for Faraz public get-data/chart-history.
# Optional: if Faraz later requires auth for private endpoints only — never commit real credentials.
# FARAZ_PHONE=
# FARAZ_PASSWORD=
# Set unique random values before production. Local-only values are rejected in production.
ADMIN_BOOTSTRAP_TOKEN=local-only-zarsignal-admin-token-2026
ADMIN_SESSION_SECRET=local-only-zarsignal-session-secret-2026-change-me
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER_API_KEY=
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret-at-least-24-chars
